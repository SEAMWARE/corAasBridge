  property PressureRange https://acme.example/ids/sm/press-17/operational#PressureRange {"min": 0, "max": 400} null null
  operation SetSpeed https://acme.example/ids/sm/press-17/operational#SetSpeed null [{"name": "speed", "valueType": "xs:double"}, {"name": "ramp", "valueType": "xs:boolean"}] [{"name": "previous", "valueType": "xs:double"}]
  operation Stop https://acme.example/ids/sm/press-17/operational#Stop null [] []
  operation Log https://acme.example/ids/sm/press-17/operational#Log null [{"name": "lines", "valueType": "xs:string"}] [{"name": "count", "valueType": "xs:int"}]
  reference Documentation https://acme.example/ids/sm/press-17/nameplate
  reference Certificate https://certs.example/p17


