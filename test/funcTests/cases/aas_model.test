#
# An AAS shell as an AssetChannel (coraine's doc/aas.md, entities natural): the shell, its submodels and their
# elements read from the AAS server (GET /shells/{id}, /submodels/{id}, the ids base64url) and handed over as the
# model - three entities:
#
#   the shell             type Shell, its assetInformation (globalAssetId, assetKind), a Relationship per submodel
#   the Nameplate         an MLP a LanguageProperty, a collection flattened (attributes), a list a ListProperty,
#                         a File its URL (a path on the server: the API's attachment URL) and contentType, a Blob
#                         the attachment URL; a Property with no value, and a Capability, make nothing
#   OperationalData       values converted by valueType (xs:double, xs:boolean), a Range { min, max }, a
#                         ReferenceElement to the Nameplate a Relationship, an external one a Property; the
#                         Operations make no attribute
#
# GET /admin/bridges/aas/inventory - the server's shells and submodels; ?from=<id> - that one's model.
#
# REQUIRE_FEATURE: ASSET_CHANNELS
#
--NAME--
aas bridge - a shell and its submodels as entities: elements to attributes, the inventory

--TAGS--
bridge aas

--INIT--
rm -rf "${AAS_TEST_DIR:?}"
mkdir -p "$AAS_TEST_DIR"
cat > $AAS_TEST_DIR/bridges.json <<J
{ "aas": { "server": { "url": "http://localhost:$AAS_MOCK_PORT" },
           "ngsild": { "defaultEntity": false, "assetChannels": {
             "https://acme.example/ids/aas/press-17": { "entities": "natural" } } } } }
J
mockStart
brokerStart --apiPlugins admin

--RUN--
B="localhost:$AAS_PORT/ngsi-ld/v1"
entityAwait https://acme.example/ids/sm/press-17/operational pressure 212.5

echo "01. The three entities"
echo "======================"
curl -s "$B/entities?type=Shell,Nameplate,OperationalData" | python3 -c 'import sys, json
print(json.dumps(sorted(json.load(sys.stdin), key=lambda e: e["id"]), indent=2, sort_keys=True))'
echo
echo


echo "02. GET /assetChannels - available"
echo "=================================="
assetChannels
echo
echo


echo "03. The inventory - the server's shells and submodels"
echo "====================================================="
curl -s "localhost:$AAS_PORT/admin/bridges/aas/inventory" | python3 -c 'import sys, json; print(json.dumps(json.load(sys.stdin), indent=2, sort_keys=True))'
echo
echo


echo "04. The inventory from the operational submodel - its model, the Operations with their variables"
echo "================================================================================================="
curl -s "localhost:$AAS_PORT/admin/bridges/aas/inventory?from=$(urlEncode https://acme.example/ids/sm/press-17/operational)" | python3 -c 'import sys, json
m = json.load(sys.stdin)
print(m["node"], m["id"], m["name"])
for c in m["children"]:
    print(" ", c["node"], c["name"], c.get("id", "-"), json.dumps(c.get("value")), json.dumps(c.get("input")), json.dumps(c.get("output")))
for r in m.get("references", []):
    print("  reference", r["type"], r["target"])'
echo
echo


echo "05. The inventory from an id the server does not have - 404"
echo "==========================================================="
curl -s -o /dev/null -w "%{http_code}\n" "localhost:$AAS_PORT/admin/bridges/aas/inventory?from=urn:nothing"
echo
echo


--TEARDOWN--
brokerStop
mockStop
rm -f "${AAS_TEST_DIR:?}/bridges.json"

--EXPECT--
01. The three entities
======================
