#
# FILE            aas_poll.test
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
# An AssetChannel's model read again every pollInterval (channelInfo): a value changed at the source is handed
# over as { "values": [ ... ] } - the attribute written again, its observedAt the read's time; a change of the
# model's structure (an element added, one removed) hands the model over again - what the model no longer has
# is left alone. A server that cannot be reached makes the channel dormant, with why; back, it is available,
# and its model is read as the server now has it.
#
#   https://acme.example/ids/aas/press-17   pollInterval PT0.2S
#   https://acme.example/ids/aas/press-18   refers to a submodel the server does not have - the shell alone
#   urn:nothing                             no such shell or submodel - dormant
#   urn:badPoll                             pollInterval 5s - not an ISO 8601 duration: refused
#
# REQUIRE_FEATURE: ASSET_CHANNELS
#
--NAME--
aas bridge - the model read every pollInterval: changed values, a changed structure, a server lost and back

--TAGS--
bridge aas

--INIT--
rm -rf "${AAS_TEST_DIR:?}"
mkdir -p "$AAS_TEST_DIR"
cat > $AAS_TEST_DIR/bridges.json <<J
{ "aas": { "server": { "url": "http://localhost:$AAS_MOCK_PORT" },
           "ngsild": { "defaultEntity": false, "assetChannels": {
             "https://acme.example/ids/aas/press-17": { "entities": "natural", "channelInfo": [ { "key": "pollInterval", "value": "PT0.2S" } ] },
             "https://acme.example/ids/aas/press-18": { "entities": "natural" },
             "urn:nothing":                           { "entities": "natural" },
             "urn:badPoll":                           { "entities": "natural", "channelInfo": [ { "key": "pollInterval", "value": "5s" } ] } } } } }
J
mockStart
brokerStart

--RUN--
OP=https://acme.example/ids/sm/press-17/operational
NP=https://acme.example/ids/sm/press-17/nameplate
entityAwait $OP pressure 212.5

echo "01. The pressure 230 at the source - the attribute written again, observedAt the read's time"
echo "============================================================================================"
mockSet $OP Pressure '"230"'
entityAwait $OP pressure 230
entityGet $OP pressure
echo
echo


echo "02. The manufacturer's name at the source - still a LanguageProperty"
echo "===================================================================="
mockSet $NP ManufacturerName '[{"language": "en", "text": "ACME Presses Ltd"}]'
entityAwait $NP manufacturerName 'Ltd'
entityGet $NP manufacturerName keyValues
echo
echo


echo "03. An element added at the source - the model again: the new attribute"
echo "======================================================================="
mockAdd $OP '{"modelType": "Property", "idShort": "Temperature", "valueType": "xs:double", "value": "48.1"}'
entityAwait $OP temperature 48.1
entityGet $OP pressure,temperature,mode keyValues
echo
echo


echo "04. Mode removed at the source - the model again; mode is left alone"
echo "===================================================================="
mockRemove $OP Mode
mockSet $OP Pressure '"231"'
entityAwait $OP pressure 231
entityGet $OP pressure,temperature,mode keyValues
echo
echo


echo "05. Press18 - its submodel is not on the server: the shell alone"
echo "================================================================"
entityGet https://acme.example/ids/aas/press-18 '' keyValues
echo
echo


echo "06. GET /assetChannels - urn:nothing dormant (no such shell), urn:badPoll refused"
echo "================================================================================="
assetChannels
echo
echo


echo "07. The server stops - press-17 dormant, why"
echo "============================================"
mockStop
channelAwait https://acme.example/ids/aas/press-17 dormant
assetChannels | grep press-17
echo
echo


echo "08. The server back (as it started) - available, the model as it has it: pressure 212.5, mode again"
echo "==================================================================================================="
mockStart
channelAwait https://acme.example/ids/aas/press-17 available
entityAwait $OP pressure 212.5
entityGet $OP pressure,temperature,mode keyValues
echo
echo


--TEARDOWN--
brokerStop
mockStop
rm -f "${AAS_TEST_DIR:?}/bridges.json"

--EXPECT--
01. The pressure 230 at the source - the attribute written again, observedAt the read's time
============================================================================================
{
  "id": "https://acme.example/ids/sm/press-17/operational",
  "pressure": {
    "observedAt": "REGEX(20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\.[0-9]{1,3})?Z)",
    "type": "Property",
    "value": 230
  },
  "type": "OperationalData"
}


02. The manufacturer's name at the source - still a LanguageProperty
====================================================================
{
  "id": "https://acme.example/ids/sm/press-17/nameplate",
  "manufacturerName": {
    "languageMap": {
      "en": "ACME Presses Ltd"
    }
  },
  "type": "Nameplate"
}


03. An element added at the source - the model again: the new attribute
=======================================================================
{
  "id": "https://acme.example/ids/sm/press-17/operational",
  "mode": "auto",
  "pressure": 230,
  "temperature": 48.1,
  "type": "OperationalData"
}


04. Mode removed at the source - the model again; mode is left alone
====================================================================
{
  "id": "https://acme.example/ids/sm/press-17/operational",
  "mode": "auto",
  "pressure": 231,
  "temperature": 48.1,
  "type": "OperationalData"
}


05. Press18 - its submodel is not on the server: the shell alone
================================================================
{
  "assetKind": "Instance",
  "id": "https://acme.example/ids/aas/press-18",
  "type": "Shell"
}


06. GET /assetChannels - urn:nothing dormant (no such shell), urn:badPoll refused
=================================================================================
https://acme.example/ids/aas/press-17 available - in valuesIn=2 valuesOut=-
https://acme.example/ids/aas/press-18 available - in valuesIn=0 valuesOut=-
urn:badPoll dormant channelInfo pollInterval is an ISO 8601 duration of at least 0.1 s - PT5S, PT0.5S, PT1M in valuesIn=0 valuesOut=-
urn:nothing dormant the server has no shell and no submodel 'urn:nothing' in valuesIn=0 valuesOut=-


07. The server stops - press-17 dormant, why
============================================
https://acme.example/ids/aas/press-17 dormant GET /shells/aHR0cHM6Ly9hY21lLmV4YW1wbGUvaWRzL2Fhcy9wcmVzcy0xNw: connect: Connection refused in valuesIn=2 valuesOut=-


08. The server back (as it started) - available, the model as it has it: pressure 212.5, mode again
===================================================================================================
{
  "id": "https://acme.example/ids/sm/press-17/operational",
  "mode": "auto",
  "pressure": 212.5,
  "temperature": 48.1,
  "type": "OperationalData"
}


